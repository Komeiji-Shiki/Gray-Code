# 开发文件
.vscode/**
.vscode-test/**
.gitignore
tsconfig.json
**/*.map
*.vsix
.graycode/**
.limcode/**
fast-tavern-main/**
.tmp/**
extension.ts
index.ts

# 锁文件
pnpm-lock.yaml
package-lock.json
yarn.lock

# 测试相关（不打包进扩展）
test/**
jest.backend.config.js
tsconfig.test.json
coverage/**
.jest-cache/**
.ts-jest/**
.cache/**

# 临时/本地文件（不打包）
diff_analyzer.py
graycode-settings*.json
limcode-settings*.json
report.md

# Claude Code 本地工作区配置（不打包）
.claude/**

# 日志文件（本地调试产物不打包）
*.log
*.log.*
logs/**

# 后端源文件和文档（esbuild 已打包到 dist/extension.js）
backend/**
webview/**
esbuild.config.js

# 内部开发文档（不打包）
docs/**
*.plan.md
AUDIT_REMEDIATION.md
HEAD
PLAN.md
.github/**
CHANGELOG.mdpstream/main

# 前端源文件（只需要 dist）
frontend/src/**
frontend/node_modules/**
frontend/*.json
frontend/*.ts
frontend/*.html
frontend/tsconfig*.json
frontend/vite.config.ts
frontend/pnpm-lock.yaml
frontend/COMPONENT_ARCHITECTURE.md

# 依赖：运行时依赖已由 esbuild 打包进 dist/（bundle + dist/node_modules），
# codicons 等静态资源使用 resources/ 目录，根 node_modules 不需要进包
node_modules/**

# Electron 独立桌面版：含用户数据（conversations/设置/本地存储）与构建产物，
# 绝不进扩展包，避免真实会话与明文配置随 VSIX 发布
electron-app/**
