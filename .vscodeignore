tsconfig.json
**/*.map
*.vsix
.graycode/**
.limcode/**
fast-tavern-main/**
.tmp/**
extension.ts
index.ts

# GitHub 工作流 / 发布脚本（开发用，不打包）
.github/**
scripts/**

# 锁文件
pnpm-lock.yaml
package-lock.json
yarn.lock

# 测试相关（不打包进扩展）
test/**
jest.backend.config.js
tsconfig.test.json
coverage/**
.jest-cache/**
.ts-jest/**
.cache/**

# 临时/本地文件（不打包）
diff_analyzer.py
graycode-settings*.json
limcode-settings*.json
splash-preview.html
report.md
.env
.env.*
*.pem
*.key

# Claude Code 本地工作区配置（不打包）
.claude/**

# 日志文件（本地调试产物不打包）
*.log
*.log.*
logs/**
run-logs.zip

# 后端源文件和文档（esbuild 已打包到 dist/extension.js）
backend/**
webview/**
esbuild.config.js

# 内部开发文档（不打包）
docs/**
*.plan.md
AUDIT_REMEDIATION.md

# 前端源文件（只需要 dist）
frontend/src/**
frontend/node_modules/**
