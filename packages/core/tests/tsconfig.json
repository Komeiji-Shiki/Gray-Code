{
  // 平台 Jest 只转译不做类型检查；这里按服务端的严格度检查测试。
  "extends": "../../../apps/server/tsconfig.json",
  "compilerOptions": {
    "types": ["node", "jest"],
    "baseUrl": "../../..",
    "paths": {
      "@graycode/contracts": ["packages/contracts/src/index.ts"],
      "@shared/*": ["shared/*"],
      "@/*": ["frontend/src/*"]
    },
    "noEmit": true
  },
  "include": ["**/*.ts"]
}
