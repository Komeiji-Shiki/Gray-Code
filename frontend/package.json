{
  "name": "graycode-frontend",
  "version": "2.0.0-pre.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "build:platform": "vue-tsc --noEmit && vite build --config vite.platform.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "build:platform:trial": "vite build --config vite.platform.config.ts"
  },
  "dependencies": {
    "file-icons-js": "^1.1.0",
    "highlight.js": "^11.12.0",
    "js-tiktoken": "^1.0.21",
    "katex": "^0.18.10",
    "markdown-it": "^14.3.2",
    "markdown-it-container": "^4.0.0",
    "markdown-it-deflist": "^3.0.1",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.17.2",
    "pinia": "^2.1.7",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.0.0"
  },
  "license": "SEE LICENSE IN LICENSE"
}
