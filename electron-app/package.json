{
  "name": "graycode-desktop",
  "version": "1.7.8",
  "description": "GrayCode desktop app (Electron) - AI coding assistant, no VS Code installation needed (runs on a built-in vscode-shim compat layer)",
  "author": {
    "name": "czocelot",
    "email": "264626877+czocelot@users.noreply.github.com",
    "url": "https://github.com/czocelot/Gray-Code-Desktop"
  },
  "homepage": "https://github.com/czocelot/Gray-Code-Desktop",
  "license": "MIT",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "build:dev": "node build.mjs --dev",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc -p . --noEmit",
    "build:all": "npm --prefix ../frontend run build && node patch-dist.mjs && node build.mjs",
    "patch": "node patch-dist.mjs",
    "start": "npm run build:all && electron .",
    "dev": "electron .",
    "e2e": "node build.mjs && cross-env GRAYCODE_E2E=1 electron .",
    "smoke": "node build.mjs && cross-env GRAYCODE_UISMOKE=1 electron .",
    "clean:release": "node -e \"require('fs').rmSync('release', { recursive: true, force: true })\"",
    "dist": "npm run clean:release && npm run build:all && electron-builder",
    "dist:win": "npm run clean:release && npm run build:all && npm run patch:portable && electron-builder --win",
    "patch:portable": "node patch-portable.mjs",
    "dist:mac": "npm run clean:release && npm run build:all && electron-builder --mac",
    "dist:linux": "npm run clean:release && npm run build:all && electron-builder --linux"
  },
  "build": {
    "appId": "dev.graycode.desktop",
    "productName": "GrayCode",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "frontend/dist"
      },
      {
        "from": "../resources",
        "to": "resources"
      },
      {
        "from": "renderer",
        "to": "renderer"
      },
      {
        "from": "../package.json",
        "to": "package.json"
      },
      {
        "from": "../CHANGELOG.md",
        "to": "CHANGELOG.md"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "icon": "../resources/icon.png"
    },
    "electronLanguages": [
      "en-US",
      "zh-CN",
      "ja"
    ],
    "portable": {
      "artifactName": "GrayCode-Portable-${version}.${ext}",
      "unpackDirName": "GrayCode-Portable"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "GrayCode.Setup.${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "../resources/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "../resources/icon.png",
      "category": "Development"
    }
  },
  "devDependencies": {
    "@types/node": "^24.10.2",
    "cross-env": "^7.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.27.2",
    "typescript": "^5.9.3"
  }
}
